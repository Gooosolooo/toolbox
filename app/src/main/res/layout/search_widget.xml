<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/search_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_search_widget"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_search_widget_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tool_search"
                android:tint="@color/widget_hint" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_hint"
                android:textColor="@color/widget_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:text="@string/search_xiaohongshu"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:text="@string/search_douyin"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:text="@string/search_widget_bilibili"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:text="@string/search_chrome"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
