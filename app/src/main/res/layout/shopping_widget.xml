<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_search_widget">

    <TextView
        android:id="@+id/shopping_widget_add"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_search_widget_field"
        android:gravity="center"
        android:text="@string/shopping_add"
        android:textColor="@color/widget_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/shopping_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/shopping_view_list"
        android:textColor="@color/widget_ink"
        android:textSize="15sp" />
</LinearLayout>
